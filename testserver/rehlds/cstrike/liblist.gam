// liblist.gam — generated by the CSB Server Creator
// https://counter-strike-boost.com/addons/server-builder
//
// ===========================================================================
//  WHY THIS FILE WAS REPLACED
// ===========================================================================
//  This is the ONE file that has to change for Metamod to load at all. The
//  engine reads gamedll_linux from here to decide which library runs the game,
//  so it has to point at Metamod, which then loads the real game library and
//  every plugin on top of it.
//
//  EXACTLY ONE LINE IS FUNCTIONALLY DIFFERENT from a stock Counter-Strike
//  install: gamedll_linux. Everything else below is the stock value, and on a
//  dedicated server most of it is inert (startmap and trainmap only matter for
//  listen servers, gamedll is the Windows path and is ignored on Linux).
//
//  TO REVERT TO A PLAIN NON-METAMOD SERVER:
//    change gamedll_linux back to   "dlls/cs.so"
//  That single edit is the whole rollback — nothing else here needs touching.
//
//  Note that Metamod does NOT need to be told where the real game library is:
//  it auto-detects it from the game directory (see addons/metamod/config.ini,
//  "gamedll ... Default is empty, with gamedll being auto-recognized based on
//  the gamedir"). So this keeps working if you swap in ReGameDLL later.
// ===========================================================================

game "Counter-Strike"

// Listen-server only — ignored by a dedicated server.
startmap "cs_havana"
trainmap "tr_1"

// Windows game library. Untouched: these builds are Linux-only, so the engine
// never reads this line. Left at stock so the file stays valid on Windows.
gamedll "dlls\mp.dll"

// >>> THE ONLY LINE WE CHANGED <<<
// stock value: "dlls/cs.so"
gamedll_linux "addons/metamod/metamod_i386.so"

// Stock values below this point.
mpentity "info_player_start"
secure "1"
type "multiplayer_only"
cldll "1"
hlversion "1110"
edicts "1800"
fallback_dir "valve"
