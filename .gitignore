# Rust build output.
/target

# Python caches from scripts/metrics.py and friends.
__pycache__/
*.pyc

# Packet captures. These are large, are regenerated by `harness capture`, and
# are only valid for the exact server build and map they were taken on -- a
# stale capture is worse than no capture, because it looks authoritative.
/captures
*.bin.sent

# HLDS log files, bind-mounted out of the container by docker-compose.
/testserver/logs

# Game content copied out of the container (maps for navigation, sprites for
# consistency hashing). Reproducible via `harness setup`; not ours to ship.
/testserver/cstrike

# The CSB server bundle: a downloaded build artefact, and its predecessor kept
# only long enough to compare. testserver/rehlds/ is the installed stack and IS
# tracked, because which build the bots were tested against is part of the result.
/testserver/bundle/
/testserver/rehlds.old/

# Local run artefacts from the control GUI
gui_run.log
rubots-gui.conf
