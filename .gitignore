# Rust build output.
/target

# Packet captures. These are large, are regenerated by `harness capture`, and
# are only valid for the exact server build and map they were taken on -- a
# stale capture is worse than no capture, because it looks authoritative.
/captures
*.bin.sent

# HLDS log files, bind-mounted out of the container by docker-compose.
/testserver/logs

# Game content copied out of the container (maps for navigation, sprites for
# consistency hashing). Reproducible via `harness setup`; not ours to ship.
/testserver/cstrike
